# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/
/cypress/videos/
/cypress/screenshots/

# next.js
/.next/
/out/
.swc/

# production
/build
/dist/

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env*.local
.env.development
.env.test
.env.production
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Genkit files
.genkit/*
.genkit-env

# IDE specific files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Generated files
.eslintcache
.stylelintcache
*.cache
.turbo

# Project specific files to ignore
.idx/
.modified

# Optional project specific ignores
# Uncomment if these apply to your project
# /public/sw.js
# /public/workbox-*.js
# /public/worker-*.js
# /public/sw.js.map
# /public/workbox-*.js.map
# /public/worker-*.js.map
